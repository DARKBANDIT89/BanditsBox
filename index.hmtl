<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BanditBox</title>
<style>
  body { margin: 0; background: #111; color: #eee; font-family: sans-serif; }
  #canvas { display: block; background: #fff; touch-action: none; }
  .bar { padding: 8px; background: #222; display: flex; gap: 8px; align-items: center; }
  button { padding: 6px 12px; }
</style>
</head>
<body>
<div class="bar">
  <button id="clear">Clear</button>
  <label>Size <input type="range" id="size" min="1" max="40" value="4"></label>
  <label>Color <input type="color" id="color" value="#000000"></label>
</div>
<canvas id="canvas"></canvas>
<script>
const c = document.getElementById('canvas');
const ctx = c.getContext('2d');
let drawing = false, lastX = 0, lastY = 0;
function resize() { c.width = innerWidth; c.height = innerHeight - 50; ctx.fillStyle = '#fff'; ctx.fillRect(0,0,c.width,c.height); }
resize(); addEventListener('resize', resize);
const sizeEl = document.getElementById('size');
const colorEl = document.getElementById('color');
function pos(e) { const r = c.getBoundingClientRect(); const t = e.touches ? e.touches[0] : e; return ; }
function start(e) { drawing = true; = pos(e); }
function move(e) { if (!drawing) return; e.preventDefault(); const = pos(e); ctx.strokeStyle = colorEl.value; ctx.lineWidth = sizeEl.value; ctx.lineCap = 'round'; ctx.beginPath(); ctx.moveTo(lastX, lastY); ctx.lineTo(x, y); ctx.stroke(); lastX = x; lastY = y; }
function stop() { drawing = false; }
c.addEventListener('mousedown', start); c.addEventListener('mousemove', move); c.addEventListener('mouseup', stop); c.addEventListener('mouseleave', stop);
c.addEventListener('touchstart', start); c.addEventListener('touchmove', move); c.addEventListener('touchend', stop);
document.getElementById('clear').onclick = () => { ctx.fillStyle = '#fff'; ctx.fillRect(0,0,c.width,c.height); };
</script>
</body>
</html>